# Groq API key (free tier at https://console.groq.com). Can also be added from the
# key button in the header, which stores it in the browser.
GROQ_API_KEY=""

# Brand knowledge: path to your context file (relative paths resolve from this folder).
# Start from examples/content-context.example.md.
CONTENT_CONTEXT_FILE="./content-context.md"

# The site you write for.
SITE_NAME="Example Site"
SITE_URL="https://example.com"
# URL path posts are served under ("/blog" -> https://example.com/blog/<slug>). Use "/" for the site root.
BLOG_PATH="/blog"

# Folder where posts are read from and saved to as <slug>.md, usually your site's
# content folder, e.g. "/path/to/site/src/content/blog" or "../site/content/blog".
CONTENT_OUTPUT_DIR=""

# Content calendar (JSON). Defaults to ./data/content-calendar.json.
CALENDAR_FILE="./data/content-calendar.json"

# Optional: Groq model overrides.
# DRAFT_MODEL drafts and plans posts, FAST_MODEL plans keywords and is the fallback,
# REWRITE_MODELS (comma-separated, in order) does the spoken-voice rewrite.
DRAFT_MODEL="openai/gpt-oss-120b"
FAST_MODEL="openai/gpt-oss-20b"
REWRITE_MODELS="qwen/qwen3.8-27b,openai/gpt-oss-120b"

# Optional: Google Search Console, shows clicks/impressions per post in the Posts tab.
# Service account with the Search Console API enabled, added as a user on the property.
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
# "sc-domain:example.com" (domain property) or "https://example.com/" (URL-prefix property)
GSC_SITE_URL=""

# Optional: Originality.ai key. When set, each draft is scanned and re-humanized
# (up to 2 more times) if it scores 50%+ AI, keeping the lowest-scoring version.
ORIGINALITY_API_KEY=""
