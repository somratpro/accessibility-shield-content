# ---------------------------------------------------------------------------
# Your site (required)
# ---------------------------------------------------------------------------

# Folder your site reads blog posts from. Posts are listed from and saved here
# as <slug>.md. Relative paths start from this folder.
# Example: "../my-site/src/content/blog"
CONTENT_DIR=""

# Path to your context file: your site's name, URL and what the writer should
# know about your brand. Leave empty to use the nearest content-context.md in
# CONTENT_DIR or a folder above it, such as your site's repo root.
# Example: "../my-site/content-context.md"
CONTEXT_FILE=""

# Groq API key, free at https://console.groq.com/keys. Can also be added from
# the key button in the app's header instead.
GROQ_API_KEY=""

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Google Search Console: clicks and impressions per post. Use a service account
# with the Search Console API enabled, added as a user on your property.
GSC_CLIENT_EMAIL=""
GSC_PRIVATE_KEY=""
# Only if the property isn't registered under the context file's url
# ("sc-domain:example.com" or "https://example.com/").
GSC_SITE_URL=""

# Originality.ai: scans each draft and re-humanizes it (up to 2 more times) if
# it scores 50%+ AI, keeping the lowest-scoring version.
ORIGINALITY_API_KEY=""

# Groq models. DRAFT_MODEL drafts posts and suggests ideas, FAST_MODEL plans
# keywords and is the fallback, REWRITE_MODELS (comma-separated, in order) does
# the spoken-voice rewrite.
# DRAFT_MODEL="openai/gpt-oss-120b"
# FAST_MODEL="openai/gpt-oss-20b"
# REWRITE_MODELS="qwen/qwen3.8-27b,openai/gpt-oss-120b"
